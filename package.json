{
  "name": "solar-slinger",
  "productName": "Solar Slinger",
  "version": "0.1.0",
  "description": "Top-down 2D gravity-sandbox space game",
  "author": "Mark Wright <mark@mark3wright.com>",
  "homepage": "https://github.com/mark3apps/solar-slinger",
  "desktopName": "solar-slinger",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "serve": "python3 serve.py",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "changelog": "node scripts/changelog.mjs"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mark3apps.solar-slinger",
    "productName": "Solar Slinger",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "mark3apps",
      "repo": "solar-slinger"
    },
    "afterPack": "scripts/adhoc-sign-mac.js",
    "files": [
      "electron/**/*",
      "index.html",
      "style.css",
      "src/**/*",
      "assets/**/*",
      "!**/.DS_Store"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "linux": {
      "category": "Game",
      "synopsis": "Top-down 2D gravity-sandbox space game",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "rpm",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "appImage": {
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "${name}-setup-${version}.${ext}",
      "oneClick": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
